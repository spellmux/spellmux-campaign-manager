CAMPAIGN_ENV=development
CAMPAIGN_HOST=0.0.0.0
CAMPAIGN_PORT=8088
CAMPAIGN_DATABASE_PASSWORD=replace-with-a-long-url-safe-password
CAMPAIGN_HTTP_PORT=8088
CAMPAIGN_ARTIFACT_PATH=./data/artifacts
CAMPAIGN_PUBLISH_PATH=./data/publish
CAMPAIGN_DATABASE_URL=postgresql+psycopg://campaign:password@database:5432/campaign
CAMPAIGN_ARTIFACT_ROOT=/data/artifacts
CAMPAIGN_PUBLISH_ROOT=/data/publish
CAMPAIGN_MODEL_ROOT=/data/models
CAMPAIGN_TRANSCRIPTION_PROVIDER=faster-whisper
CAMPAIGN_WHISPER_MODEL=small.en
CAMPAIGN_WHISPER_DEVICE=cpu
CAMPAIGN_WHISPER_COMPUTE_TYPE=int8
CAMPAIGN_WHISPER_CPU_THREADS=4
CAMPAIGN_LOG_LEVEL=INFO
